# Copy to .env and replace all placeholder values before running Docker Compose. Never commit .env.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# PostgreSQL container password (used by db and web services)
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Direct connection string when running outside Docker (or override via dotnet user-secrets locally)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=clutch_db;Username=postgres;Password=REPLACE_WITH_STRONG_DB_PASSWORD

# Initial Administrator account seeded when running `dotnet run -- --seed`
SeedAdmin__Email=admin@clutch.local
SeedAdmin__Password=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Optional password assigned to sample demo accounts when running `dotnet run -- --seed-demo`
SeedDemo__Password=REPLACE_WITH_DEMO_PASSWORD

# Optional SMTP settings for notification emails (leave Smtp__Host empty for console/mock mode)
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@clutch.local
