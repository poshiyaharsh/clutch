@model Clutch.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row justify-content-center my-4">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="cl-card">
      <div class="mb-4">
        <span class="cl-sticker mb-2">Welcome back</span>
        <h1 class="h2 mb-1">Sign in to Clutch</h1>
        <p class="text-muted">Enter your credentials to access your hackathons and teams.</p>
      </div>

      <form asp-action="Login" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="cl-error mb-3"></div>

        <div class="cl-field">
          <label class="cl-label" asp-for="Email">Email</label>
          <input class="cl-input" asp-for="Email" placeholder="you@domain.com" autocomplete="username" />
          <span class="cl-error" asp-validation-for="Email"></span>
        </div>

        <div class="cl-field">
          <label class="cl-label" asp-for="Password">Password</label>
          <input class="cl-input" asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
          <span class="cl-error" asp-validation-for="Password"></span>
        </div>

        <div class="form-check mb-4">
          <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
          <label class="form-check-label" for="rememberMeCheck">Remember this browser</label>
        </div>

        <button class="cl-btn cl-btn--primary w-100 mb-3" type="submit">Sign in</button>

        <p class="text-center small text-muted mb-0">
          Do not have an account? <a asp-action="Register">Create an account</a>
        </p>
      </form>
    </div>
  </div>
</div>
