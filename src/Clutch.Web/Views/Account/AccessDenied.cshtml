@{
    ViewData["Title"] = "Access restricted";
}

<div class="row justify-content-center py-5">
  <div class="col-12 col-md-8 col-lg-6">
    <div class="text-center mb-4">
      <a asp-controller="Home" asp-action="Index" aria-label="Clutch home" class="d-inline-block">
        <partial name="_Logo" model='("md", "full")' />
      </a>
    </div>

    <div class="cl-card text-center p-5">
      <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle mb-3 bg-danger-subtle text-danger">
        <svg class="cl-icon cl-icon-lg"><use href="/img/icons.svg#icon-shield"></use></svg>
      </div>
      <h1 class="cl-title-section mb-2">Access restricted</h1>
      <p class="cl-text-muted cl-max-48ch mx-auto mb-4">
        You do not possess the required permissions or role to view this resource. Contact an administrator or sign in with an authorized account.
      </p>
      <div class="d-flex justify-content-center gap-3">
        <a class="cl-btn cl-btn--secondary" asp-controller="Home" asp-action="Index">Back to home</a>
        <a class="cl-btn cl-btn--primary" asp-controller="Account" asp-action="Login">Sign in</a>
      </div>
    </div>
  </div>
</div>
