@model Clutch.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center py-5">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
    <div class="text-center mb-4">
      <a asp-controller="Home" asp-action="Index" aria-label="Clutch home" class="d-inline-block">
        <partial name="_Logo" model='("lg", "full")' />
      </a>
    </div>

    <div class="cl-card p-4 p-md-5">
      <div class="text-center mb-4">
        <h1 class="cl-title-card cl-font-22 mb-1">Create your account</h1>
        <p class="cl-text-muted cl-font-14 mb-0">Compete, collaborate, and build with Clutch</p>
      </div>

      <form asp-action="Register" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="cl-error mb-3"></div>

        <div class="cl-field">
          <label class="cl-label" asp-for="DisplayName">Full Name or Handle</label>
          <input class="cl-input" asp-for="DisplayName" placeholder="Alex Rivera" required />
          <span class="cl-error" asp-validation-for="DisplayName"></span>
        </div>

        <div class="cl-field">
          <label class="cl-label" asp-for="Email">Email Address</label>
          <input class="cl-input" asp-for="Email" placeholder="alex@example.com" autocomplete="username" required />
          <span class="cl-error" asp-validation-for="Email"></span>
        </div>

        <div class="cl-field">
          <label class="cl-label" asp-for="CollegeOrCompany">Institution / Company (optional)</label>
          <input class="cl-input" asp-for="CollegeOrCompany" placeholder="Stanford University or Company Inc." />
          <span class="cl-error" asp-validation-for="CollegeOrCompany"></span>
        </div>

        <div class="cl-field">
          <label class="cl-label" asp-for="DesiredRole">Account Role</label>
          <select class="cl-select" asp-for="DesiredRole">
            <option value="Participant">Participant — Join teams and build projects</option>
            <option value="Organizer">Organizer — Create and manage hackathons</option>
          </select>
        </div>

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="cl-field">
              <label class="cl-label" asp-for="Password">Password</label>
              <div class="position-relative">
                <input id="reg-pwd" class="cl-input cl-input-pwd" asp-for="Password" type="password" placeholder="At least 6 chars" autocomplete="new-password" required />
                <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted pe-3 p-0" onclick="togglePasswordVisibility('reg-pwd', this)" aria-label="Toggle password visibility">
                  <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-eye"></use></svg>
                </button>
              </div>
              <span class="cl-error" asp-validation-for="Password"></span>
            </div>
          </div>

          <div class="col-12 col-md-6">
            <div class="cl-field">
              <label class="cl-label" asp-for="ConfirmPassword">Confirm Password</label>
              <div class="position-relative">
                <input id="reg-cpwd" class="cl-input cl-input-pwd" asp-for="ConfirmPassword" type="password" placeholder="Repeat password" autocomplete="new-password" required />
                <button type="button" class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted pe-3 p-0" onclick="togglePasswordVisibility('reg-cpwd', this)" aria-label="Toggle confirm password visibility">
                  <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-eye"></use></svg>
                </button>
              </div>
              <span class="cl-error" asp-validation-for="ConfirmPassword"></span>
            </div>
          </div>
        </div>

        <button class="cl-btn cl-btn--primary w-100 mb-3" type="submit">
          <span>Create account</span>
        </button>

        <p class="text-center cl-text-muted cl-font-13 mb-0">
          Already have an account? <a asp-action="Login" class="fw-semibold">Sign in</a>
        </p>
      </form>
    </div>
  </div>
</div>
