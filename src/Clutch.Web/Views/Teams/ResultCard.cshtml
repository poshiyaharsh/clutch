@model Clutch.Web.Domain.Team
@{
    ViewData["Title"] = $"{Model.Name} — Certificate of Participation";
    var rank = (int)(ViewData["Rank"] ?? 0);
    var score = (decimal)(ViewData["Score"] ?? 0m);
    var isLocked = (bool)(ViewData["IsLocked"] ?? false);
}

<div class="row justify-content-center my-4">
  <div class="col-12 col-lg-8">
    <div class="cl-card p-4 p-md-5 position-relative overflow-hidden border-3">
      <!-- Watermark / Brand Header -->
      <div class="d-flex justify-content-between align-items-center pb-4 mb-4 border-bottom">
        <div class="d-flex align-items-center gap-2">
          <img src="~/favicon.svg" alt="" width="42" height="42" />
          <span class="display h3 mb-0">Clutch</span>
        </div>
        <div class="text-end">
          <span class="cl-sticker cl-sticker--open py-1 px-3">Official Result Card</span>
        </div>
      </div>

      <!-- Main certificate content -->
      <div class="text-center py-3">
        <p class="text-muted text-uppercase letter-spacing-2 small mb-2">This is proudly awarded to squad</p>
        <h1 class="display h1 mb-2 text-primary">@Model.Name</h1>

        <p class="lead mb-4">
          For building <strong>@(Model.Submission?.Title ?? "an innovative prototype")</strong> at
          <span class="fw-bold">@Model.Hackathon.Title</span>.
        </p>

        @if (rank > 0)
        {
          <div class="d-inline-flex align-items-center gap-3 p-3 px-4 border rounded-pill bg-light my-2">
            <span class="display h2 mb-0 text-primary">Rank #@rank</span>
            <span class="text-muted">|</span>
            <span class="fw-bold fs-5">@score.ToString("F1") / 100 pts</span>
          </div>
        }
      </div>

      <!-- Squad members -->
      <div class="mt-4 pt-3 border-top">
        <h2 class="small text-muted text-uppercase letter-spacing-1 mb-3">Squad Roster</h2>
        <div class="d-flex flex-wrap gap-2">
          @foreach (var m in Model.Members)
          {
            <div class="badge bg-light text-dark border p-2 px-3 fs-6">
              @(m.User?.DisplayName ?? "Member")
              @if (m.UserId == Model.LeadId)
              {
                <span class="badge bg-primary ms-1">Lead</span>
              }
            </div>
          }
        </div>
      </div>

      <!-- Footer & Verification -->
      <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top small text-muted">
        <span>Verified by Clutch Hackathon Platform</span>
        <span>Issued @DateTime.UtcNow.ToString("MMMM yyyy")</span>
      </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-center gap-3 mt-4 d-print-none">
      <a class="cl-btn cl-btn--secondary" asp-action="Detail" asp-route-id="@Model.Id">Back to squad</a>
      <button class="cl-btn cl-btn--primary" type="button" onclick="window.print()">Print / Save PDF</button>
    </div>
  </div>
</div>
