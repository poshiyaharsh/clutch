@model Clutch.Web.Domain.Team
@{
    ViewData["Title"] = $"{Model.Name} — Certificate of Participation";
    var rank = (int)(ViewData["Rank"] ?? 0);
    var score = (decimal)(ViewData["Score"] ?? 0m);
    var isLocked = (bool)(ViewData["IsLocked"] ?? false);
}

<div class="row justify-content-center py-4">
  <div class="col-12 col-lg-8">
    <div class="cl-card p-4 p-md-5 position-relative overflow-hidden shadow-md">
      <!-- Brand Header -->
      <div class="d-flex justify-content-between align-items-center pb-4 mb-4 border-bottom">
        <partial name="_Logo" model='("md", "full")' />
        <div class="text-end">
          <span class="cl-badge cl-badge--success">Official Result Card</span>
        </div>
      </div>

      <!-- Main certificate content -->
      <div class="text-center py-3">
        <p class="cl-text-muted text-uppercase mb-2 cl-font-11 cl-letter-spacing-wide">This certificate recognizes team</p>
        <h1 class="cl-title-page mb-2 text-primary">@Model.Name</h1>

        <p class="fs-5 cl-text-muted mb-4">
          For building <strong>@(Model.Submission?.Title ?? "an innovative prototype")</strong> at
          <span class="fw-semibold text-body">@Model.Hackathon.Title</span>.
        </p>

        @if (rank > 0)
        {
          <div class="d-inline-flex align-items-center gap-3 p-3 px-4 rounded-pill my-2 cl-card--soft border">
            <span class="cl-title-section mb-0 text-primary tabular-nums">Rank #@rank</span>
            <span class="text-muted">|</span>
            <span class="fw-bold fs-5 tabular-nums">@score.ToString("F1") / 100 pts</span>
          </div>
        }
      </div>

      <!-- Team members -->
      <div class="mt-4 pt-3 border-top">
        <h2 class="cl-text-muted text-uppercase mb-3 cl-font-11 cl-letter-spacing-wide">Team Roster</h2>
        <div class="d-flex flex-wrap gap-2">
          @foreach (var m in Model.Members)
          {
            <div class="cl-badge cl-font-13 py-1 px-3">
              @(m.User?.DisplayName ?? "Member")
              @if (m.UserId == Model.LeadId)
              {
                <span class="text-primary ms-1 fw-bold">(Lead)</span>
              }
            </div>
          }
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top cl-text-muted cl-font-12">
        <span>Verified by Clutch Protocol</span>
        <span>Issued @DateTime.UtcNow.ToString("yyyy-MM-dd")</span>
      </div>
    </div>

    <div class="text-center mt-4">
      <a class="cl-btn cl-btn--secondary" asp-action="Detail" asp-route-id="@Model.Id">
        <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-left"></use></svg>
        <span>Back to team</span>
      </a>
      <button class="cl-btn cl-btn--primary ms-2" type="button" onclick="window.print();">
        <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-download"></use></svg>
        <span>Print certificate</span>
      </button>
    </div>
  </div>
</div>
