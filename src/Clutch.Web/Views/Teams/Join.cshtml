@model Clutch.Web.Models.TeamJoinViewModel
@{
    ViewData["Title"] = "Join Team";
}

<div class="row justify-content-center py-4">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="cl-card p-4 p-md-5">
      <div class="mb-4">
        <span class="cl-badge cl-badge--accent mb-2">@Model.HackathonTitle</span>
        <h1 class="cl-title-section mb-1">Enter team code</h1>
        <p class="cl-text-muted cl-font-14 mb-0">Enter the 8-character invite code provided by your team leader.</p>
      </div>

      <form asp-action="Join" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="HackathonId" />
        <input type="hidden" asp-for="HackathonTitle" />

        <div asp-validation-summary="ModelOnly" class="cl-error mb-3"></div>

        <div class="cl-field">
          <label class="cl-label" asp-for="JoinCode">Join code</label>
          <input class="cl-input text-uppercase fw-bold text-center cl-letter-spacing-wider cl-font-18" asp-for="JoinCode" placeholder="ABC12345" maxlength="16" required />
          <span class="cl-error" asp-validation-for="JoinCode"></span>
        </div>

        <button class="cl-btn cl-btn--primary cl-w-100 mt-3" type="submit">Join team</button>
      </form>
    </div>
  </div>
</div>
