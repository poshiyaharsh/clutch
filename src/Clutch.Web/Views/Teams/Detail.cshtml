@model Clutch.Web.Models.TeamDetailViewModel
@{
    ViewData["Title"] = $"{Model.Name} — Squad";
}

<div class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
    <div class="d-flex align-items-center gap-2">
      <span class="cl-sticker cl-sticker--open">Squad</span>
      <a class="text-muted small fw-bold text-decoration-none" asp-controller="Hackathons" asp-action="Detail" asp-route-slug="@Model.HackathonSlug">
        ← @Model.HackathonTitle
      </a>
    </div>

    @if (Model.IsCurrentUserMember)
    {
      <form asp-action="Leave" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to leave this squad?');">
        @Html.AntiForgeryToken()
        <button class="cl-btn cl-btn--ghost text-danger py-1 px-3" type="submit">Leave squad</button>
      </form>
    }
  </div>

  <h1 class="display mb-1">@Model.Name</h1>
  <p class="text-muted">Led by <strong>@Model.LeadName</strong> • @Model.Members.Count of @Model.MaxTeamSize members</p>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-8">
    <div class="cl-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Squad roster (@Model.Members.Count/@Model.MaxTeamSize)</h2>
        @if (Model.Members.Count < Model.MaxTeamSize && Model.IsRegistrationOpen)
        {
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Open slots available</span>
        }
      </div>

      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Member</th>
              <th>Organization</th>
              <th>Joined</th>
              @if (Model.IsCurrentUserLead)
              {
                <th>Lead actions</th>
              }
            </tr>
          </thead>
          <tbody>
            @foreach (var m in Model.Members)
            {
              <tr>
                <td>
                  <strong>@m.DisplayName</strong>
                  @if (m.IsLead)
                  {
                    <span class="cl-sticker ms-2 py-0">Squad Lead</span>
                  }
                </td>
                <td>@(m.CollegeOrCompany ?? "Independent")</td>
                <td class="small text-muted">@m.JoinedAt.ToString("MMM d")</td>
                @if (Model.IsCurrentUserLead)
                {
                  <td>
                    @if (!m.IsLead)
                    {
                      <div class="d-flex gap-2">
                        <form asp-action="TransferLead" asp-route-id="@Model.Id" method="post" class="d-inline">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="newLeadId" value="@m.UserId" />
                          <button class="btn btn-sm btn-outline-secondary" type="submit">Make lead</button>
                        </form>
                        <form asp-action="RemoveMember" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Remove member?');">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="memberUserId" value="@m.UserId" />
                          <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                        </form>
                      </div>
                    }
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Project Submission Section -->
    <div class="cl-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Project submission</h2>
        @if (Model.Submission != null)
        {
          <span class="cl-sticker cl-sticker--open">Submitted</span>
        }
      </div>

      @if (Model.Submission is not null)
      {
        <h3 class="h4 mb-2">@Model.Submission.Title</h3>
        @if (!string.IsNullOrEmpty(Model.Submission.TrackName))
        {
          <div class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mb-3">
            Track: @Model.Submission.TrackName
          </div>
        }
        <p class="text-muted mb-4" style="white-space: pre-line;">@Model.Submission.Description</p>

        <div class="d-flex flex-wrap gap-3 mb-4">
          <a class="cl-btn cl-btn--secondary" href="@Model.Submission.RepoUrl" target="_blank" rel="noopener">
            View code repository ↗
          </a>
          @if (!string.IsNullOrEmpty(Model.Submission.DemoUrl))
          {
            <a class="cl-btn cl-btn--secondary" href="@Model.Submission.DemoUrl" target="_blank" rel="noopener">
              View live demo ↗
            </a>
          }
        </div>

        <div class="d-flex flex-wrap gap-3 mb-4">
          @if (Model.IsCurrentUserLead && Model.IsSubmissionOpen)
          {
            <a class="cl-btn cl-btn--primary" asp-controller="Submissions" asp-action="Edit" asp-route-teamId="@Model.Id">
              Edit submission
            </a>
          }
          <a class="cl-btn cl-btn--secondary" asp-action="ResultCard" asp-route-id="@Model.Id">
            View result certificate
          </a>
        </div>
      }
      else
      {
        <p class="text-muted mb-4">No project has been submitted yet for this squad.</p>
        @if (Model.IsCurrentUserLead)
        {
          if (Model.IsSubmissionOpen)
          {
            <a class="cl-btn cl-btn--primary" asp-controller="Submissions" asp-action="Edit" asp-route-teamId="@Model.Id">
              Submit project
            </a>
          }
          else
          {
            <div class="alert alert-warning mb-0">
              Project submissions are currently closed for this hackathon.
            </div>
          }
        }
        else
        {
          <p class="small text-muted mb-0">Only the squad leader (@Model.LeadName) can submit the project.</p>
        }
      }
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="cl-card mb-4">
      <h2 class="h5 mb-2">Squad invite code</h2>
      <p class="small text-muted mb-3">Share this code with up to @(Model.MaxTeamSize - Model.Members.Count) other teammates to invite them.</p>

      <div class="p-3 border rounded text-center bg-light mb-3">
        <span class="display h3 mb-0 text-primary">@Model.JoinCode</span>
      </div>

      <button class="cl-btn cl-btn--secondary w-100" type="button" onclick="navigator.clipboard.writeText('@Model.JoinCode'); clToast('Join code copied to clipboard!');">
        Copy code
      </button>
    </div>
  </div>
</div>
