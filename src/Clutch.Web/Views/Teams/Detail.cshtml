@model Clutch.Web.Models.TeamDetailViewModel
@{
    ViewData["Title"] = $"{Model.Name} — Squad";
}

<div class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
    <div class="d-flex align-items-center gap-2">
      <span class="cl-badge cl-badge--accent">Squad</span>
      <a class="text-muted d-inline-flex align-items-center gap-1 text-decoration-none" asp-controller="Hackathons" asp-action="Detail" asp-route-slug="@Model.HackathonSlug" style="font-size: 13px;">
        <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-left"></use></svg>
        <span>@Model.HackathonTitle</span>
      </a>
    </div>

    @if (Model.IsCurrentUserMember)
    {
      <form asp-action="Leave" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to leave this squad?');" class="m-0">
        @Html.AntiForgeryToken()
        <button class="cl-btn cl-btn--danger cl-btn--sm" type="submit">Leave squad</button>
      </form>
    }
  </div>

  <h1 class="cl-title-page mb-1">@Model.Name</h1>
  <p class="cl-text-muted mb-0">Led by <strong>@Model.LeadName</strong> • @Model.Members.Count of @Model.MaxTeamSize members</p>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-8">
    <div class="cl-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="cl-title-card mb-0">Squad roster (@Model.Members.Count/@Model.MaxTeamSize)</h2>
        @if (Model.Members.Count < Model.MaxTeamSize && Model.IsRegistrationOpen)
        {
          <span class="cl-badge cl-badge--success">Open slots available</span>
        }
      </div>

      <div class="table-responsive">
        <table class="cl-table">
          <thead>
            <tr>
              <th>Member</th>
              <th>Organization</th>
              <th>Joined</th>
              @if (Model.IsCurrentUserLead)
              {
                <th class="text-end">Actions</th>
              }
            </tr>
          </thead>
          <tbody>
            @foreach (var m in Model.Members)
            {
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <span class="cl-avatar cl-avatar-sm">@(m.DisplayName.Length >= 2 ? m.DisplayName.Substring(0, 2).ToUpperInvariant() : "U")</span>
                    <strong>@m.DisplayName</strong>
                    @if (m.IsLead)
                    {
                      <span class="cl-badge cl-badge--accent">Lead</span>
                    }
                  </div>
                </td>
                <td class="text-muted">@(m.CollegeOrCompany ?? "Independent")</td>
                <td class="text-muted tabular-nums" style="font-size: 13px;">@m.JoinedAt.ToString("MMM d")</td>
                @if (Model.IsCurrentUserLead)
                {
                  <td class="text-end">
                    @if (!m.IsLead)
                    {
                      <div class="d-inline-flex gap-2">
                        <form asp-action="TransferLead" asp-route-id="@Model.Id" method="post" class="d-inline m-0">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="newLeadId" value="@m.UserId" />
                          <button class="cl-btn cl-btn--secondary cl-btn--sm" type="submit">Make lead</button>
                        </form>
                        <form asp-action="RemoveMember" asp-route-id="@Model.Id" method="post" class="d-inline m-0" onsubmit="return confirm('Remove member?');">
                          @Html.AntiForgeryToken()
                          <input type="hidden" name="memberUserId" value="@m.UserId" />
                          <button class="cl-btn cl-btn--danger cl-btn--sm" type="submit">Remove</button>
                        </form>
                      </div>
                    }
                  </td>
                }
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- Project Submission Section -->
    <div class="cl-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="cl-title-card mb-0">Project submission</h2>
        @if (Model.Submission != null)
        {
          <span class="cl-badge cl-badge--success">Submitted</span>
        }
      </div>

      @if (Model.Submission is not null)
      {
        <h3 class="cl-title-card mb-2">@Model.Submission.Title</h3>
        @if (!string.IsNullOrEmpty(Model.Submission.TrackName))
        {
          <div class="mb-3">
            <span class="cl-badge cl-badge--accent">Track: @Model.Submission.TrackName</span>
          </div>
        }
        <p class="cl-text-muted mb-4" style="white-space: pre-line; font-size: 14px;">@Model.Submission.Description</p>

        <div class="d-flex flex-wrap gap-2 mb-4">
          <a class="cl-btn cl-btn--secondary cl-btn--sm" href="@Model.Submission.RepoUrl" target="_blank" rel="noopener">
            <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-search"></use></svg>
            <span>View code repository</span>
          </a>
          @if (!string.IsNullOrEmpty(Model.Submission.DemoUrl))
          {
            <a class="cl-btn cl-btn--secondary cl-btn--sm" href="@Model.Submission.DemoUrl" target="_blank" rel="noopener">
              <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-layers"></use></svg>
              <span>View live demo</span>
            </a>
          }
        </div>

        <div class="d-flex flex-wrap gap-2 pt-3 border-top">
          @if (Model.IsCurrentUserLead && Model.IsSubmissionOpen)
          {
            <a class="cl-btn cl-btn--primary cl-btn--sm" asp-controller="Submissions" asp-action="Edit" asp-route-teamId="@Model.Id">
              Edit submission
            </a>
          }
          <a class="cl-btn cl-btn--secondary cl-btn--sm" asp-action="ResultCard" asp-route-id="@Model.Id">
            View certificate
          </a>
        </div>
      }
      else
      {
        <p class="cl-text-muted mb-4" style="font-size: 14px;">No project has been submitted yet for this squad.</p>
        @if (Model.IsCurrentUserLead)
        {
          if (Model.IsSubmissionOpen)
          {
            <a class="cl-btn cl-btn--primary cl-btn--sm" asp-controller="Submissions" asp-action="Edit" asp-route-teamId="@Model.Id">
              Submit project
            </a>
          }
          else
          {
            <div class="p-3 rounded-2" style="background: var(--warning-soft); color: var(--warning-fg); font-size: 13px;">
              Project submissions are currently closed for this hackathon.
            </div>
          }
        }
        else
        {
          <p class="text-muted mb-0" style="font-size: 13px;">Only the squad leader (@Model.LeadName) can submit the project.</p>
        }
      }
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="cl-card position-sticky" style="top: 88px;">
      <h2 class="cl-title-card mb-2">Squad invite code</h2>
      <p class="cl-text-muted mb-3" style="font-size: 13px;">Share this code with teammates so they can join your squad.</p>

      <div class="p-3 rounded-2 text-center mb-3" style="background: var(--surface-2); border: 1px dashed var(--border);">
        <span class="cl-title-section mb-0 text-primary tabular-nums">@Model.JoinCode</span>
      </div>

      <button class="cl-btn cl-btn--secondary w-100" type="button" onclick="copyText('@Model.JoinCode', 'Join code copied to clipboard');">
        <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-copy"></use></svg>
        <span>Copy code</span>
      </button>
    </div>
  </div>
</div>
