@model IReadOnlyList<Clutch.Web.Domain.AuditLog>
@{
    ViewData["Title"] = "Platform administration";
    var users = ViewData["Users"] as List<Clutch.Web.Domain.ApplicationUser> ?? [];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="mb-1">Platform administration</h1>
    <p class="text-muted mb-0">System health, directory oversight, and platform audit logs.</p>
  </div>
  <div class="d-flex gap-2">
    <a class="cl-btn cl-btn--secondary" asp-action="Audit">Full audit trail</a>
  </div>
</div>

<div class="cl-stats mb-5">
  <div class="cl-card cl-stat"><strong>@(ViewData["HackathonsCount"] ?? 0)</strong>total hackathons</div>
  <div class="cl-card cl-stat"><strong>@(ViewData["UsersCount"] ?? 0)</strong>registered users</div>
  <div class="cl-card cl-stat"><strong>@(ViewData["TeamsCount"] ?? 0)</strong>squads created</div>
  <div class="cl-card cl-stat"><strong>@(ViewData["JudgesCount"] ?? 0)</strong>active judges</div>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-8">
    <div class="cl-card">
      <h2 class="h4 mb-3">Recent users</h2>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Organization</th>
              <th>Joined</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var u in users)
            {
              <tr>
                <td><strong>@u.DisplayName</strong></td>
                <td>@u.Email</td>
                <td>@(u.CollegeOrCompany ?? "Independent")</td>
                <td class="small text-muted">@u.CreatedAt.ToString("MMM d, yyyy")</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="cl-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Audit activity</h2>
        <a class="small fw-bold" asp-action="Audit">View all</a>
      </div>

      @if (!Model.Any())
      {
        <p class="text-muted small">No audit log entries recorded yet.</p>
      }
      else
      {
        <ul class="list-unstyled d-grid gap-3 mb-0">
          @foreach (var log in Model.Take(5))
          {
            <li class="pb-2 border-bottom">
              <div class="small fw-bold">@log.Action (@log.EntityType)</div>
              <div class="text-muted small">Actor: @(log.Actor?.DisplayName ?? log.ActorId ?? "System")</div>
              <div class="text-muted small">@log.CreatedAt.ToString("g")</div>
            </li>
          }
        </ul>
      }
    </div>
  </div>
</div>
