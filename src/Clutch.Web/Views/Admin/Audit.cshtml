@model IReadOnlyList<Clutch.Web.Domain.AuditLog>
@{
    ViewData["Title"] = "System Audit Trail";
}

<div class="mb-4">
  <div class="d-flex align-items-center gap-2 mb-2">
    <span class="cl-badge cl-badge--accent">Security log</span>
    <a class="text-muted d-inline-flex align-items-center gap-1 text-decoration-none cl-font-13" asp-action="Index">
      <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-left"></use></svg>
      <span>Admin overview</span>
    </a>
  </div>
  <h1 class="cl-title-page mb-1">System Audit Trail</h1>
  <p class="cl-text-muted cl-font-14 mb-0">Immutable log of security-sensitive platform operations, state changes, and scoring locks.</p>
</div>

<div class="cl-card p-0 overflow-hidden">
  @if (!Model.Any())
  {
    <div class="p-4 text-center text-muted">No audit records found.</div>
  }
  else
  {
    <div class="table-responsive">
      <table class="cl-table">
        <thead>
          <tr>
            <th>Timestamp (UTC)</th>
            <th>Actor</th>
            <th>Action</th>
            <th>Target</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var log in Model)
          {
            <tr>
              <td class="text-muted tabular-nums cl-font-12">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
              <td><strong>@(log.Actor?.DisplayName ?? log.ActorId ?? "System")</strong></td>
              <td><span class="cl-badge">@log.Action</span></td>
              <td>@log.EntityType #@log.EntityId</td>
              <td class="text-muted cl-font-12 cl-font-mono">@(log.Details ?? "—")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
