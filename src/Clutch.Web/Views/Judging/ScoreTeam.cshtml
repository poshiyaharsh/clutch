@model Clutch.Web.Models.RubricScoreFormViewModel
@{
    ViewData["Title"] = $"Score Squad — {Model.TeamName}";
}

<div class="mb-4">
  <div class="d-flex align-items-center gap-2 mb-2">
    <span class="cl-badge cl-badge--warning">Rubric scoring</span>
    <a class="text-muted d-inline-flex align-items-center gap-1 text-decoration-none" asp-action="HackathonTeams" asp-route-id="@Model.HackathonId" style="font-size: 13px;">
      <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-left"></use></svg>
      <span>Back to squad list</span>
    </a>
  </div>
  <h1 class="cl-title-page mb-1">Evaluating @Model.TeamName</h1>
  <p class="cl-text-muted mb-0" style="font-size: 14px;">@Model.HackathonTitle @(string.IsNullOrEmpty(Model.TrackName) ? "" : $"• Track: {Model.TrackName}")</p>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-5">
    <!-- Project Submission Preview -->
    <div class="cl-card position-sticky mb-4" style="top: 88px;">
      <h2 class="cl-title-card mb-3">Project submission</h2>
      <h3 class="cl-title-card text-primary mb-2">@(Model.ProjectTitle ?? "Untitled project")</h3>
      <p class="cl-text-muted mb-4" style="white-space: pre-line; font-size: 14px; line-height: 1.5;">
        @(Model.ProjectDescription ?? "No description provided.")
      </p>

      <div class="d-grid gap-2">
        @if (!string.IsNullOrEmpty(Model.RepoUrl))
        {
          <a class="cl-btn cl-btn--secondary w-100 justify-content-between" href="@Model.RepoUrl" target="_blank" rel="noopener">
            <span class="d-flex align-items-center gap-2">
              <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-search"></use></svg>
              <span>Inspect Source Repository</span>
            </span>
            <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-external-link"></use></svg>
          </a>
        }
        @if (!string.IsNullOrEmpty(Model.DemoUrl))
        {
          <a class="cl-btn cl-btn--secondary w-100 justify-content-between" href="@Model.DemoUrl" target="_blank" rel="noopener">
            <span class="d-flex align-items-center gap-2">
              <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-layers"></use></svg>
              <span>View Live Demo</span>
            </span>
            <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-external-link"></use></svg>
          </a>
        }
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-7">
    <!-- Rubric Scoring Form -->
    <div class="cl-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="cl-title-card mb-0">Rubric criteria</h2>
        <span class="text-muted" style="font-size: 12px;">Weights total 100%</span>
      </div>

      <form asp-action="ScoreTeam" asp-route-hackathonId="@Model.HackathonId" asp-route-teamId="@Model.TeamId" method="post" novalidate data-judge-form>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="HackathonId" />
        <input type="hidden" asp-for="TeamId" />
        <input type="hidden" asp-for="TeamName" />

        <div asp-validation-summary="ModelOnly" class="cl-error mb-3"></div>

        @for (int i = 0; i < Model.Criteria.Count; i++)
        {
          <input type="hidden" asp-for="Criteria[i].CriterionId" />
          <input type="hidden" asp-for="Criteria[i].Name" />
          <input type="hidden" asp-for="Criteria[i].MaxPoints" />
          <input type="hidden" asp-for="Criteria[i].WeightPercent" />

          <div class="p-3 rounded-2 mb-3 border" style="background: var(--surface-2);">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <strong class="text-body" style="font-size: 15px;">@Model.Criteria[i].Name</strong>
              <span class="cl-badge cl-badge--accent">
                Weight: @Model.Criteria[i].WeightPercent% (Max @Model.Criteria[i].MaxPoints pts)
              </span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Criteria[i].Description))
            {
              <p class="cl-text-muted mb-3" style="font-size: 13px;">@Model.Criteria[i].Description</p>
            }

            <div class="row g-2 align-items-center mb-2">
              <div class="col-12 col-sm-4">
                <label class="cl-label" asp-for="Criteria[i].Points">Score (0–@Model.Criteria[i].MaxPoints):</label>
                <input class="cl-input tabular-nums" type="number" asp-for="Criteria[i].Points" min="0" max="@Model.Criteria[i].MaxPoints" step="0.5" required
                       id="crit-@i" data-criterion data-weight="@Model.Criteria[i].WeightPercent" />
                <span class="cl-error" asp-validation-for="Criteria[i].Points"></span>
              </div>
              <div class="col-12 col-sm-8">
                <label class="cl-label" asp-for="Criteria[i].Comment">Feedback (optional):</label>
                <input class="cl-input" type="text" asp-for="Criteria[i].Comment" placeholder="Constructive notes for the squad..." />
              </div>
            </div>
          </div>
        }

        @if (!Model.Criteria.Any())
        {
          <p class="cl-text-muted">No criteria have been configured yet for this hackathon.</p>
        }
        else
        {
          <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
            <a class="cl-btn cl-btn--secondary" asp-action="HackathonTeams" asp-route-id="@Model.HackathonId">Cancel</a>
            <button class="cl-btn cl-btn--primary" type="submit">Submit evaluation</button>
          </div>
        }
      </form>
    </div>
  </div>
</div>
