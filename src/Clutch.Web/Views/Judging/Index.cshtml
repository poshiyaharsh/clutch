@model IEnumerable<Clutch.Web.Models.JudgeHackathonListItemViewModel>
@{
    ViewData["Title"] = "Judge Portal";
}

<div class="mb-4">
  <span class="cl-badge cl-badge--warning mb-2">Evaluation panel</span>
  <h1 class="cl-title-page mb-1">Judge Assignments</h1>
  <p class="cl-text-muted cl-font-14 mb-0">Hackathons where you are assigned as a technical or product judge.</p>
</div>

@if (!Model.Any())
{
  <partial name="_EmptyState" model='("No assigned hackathons found", "When hackathon organizers add your email to their judging committee, events will appear here.", "Browse events", "/hackathons")' />
}
else
{
  <div class="row g-4">
    @foreach (var h in Model)
    {
      <div class="col-12 col-md-6 col-lg-4">
        <article class="cl-card h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <partial name="_Badge" model='(h.IsLocked ? "Locked" : "Active judging", h.IsLocked ? "closed" : "judging")' />
              <span class="text-muted cl-font-12">Ends @h.EndsAt.ToString("MMM d")</span>
            </div>
            <h2 class="cl-title-card mb-2">@h.Title</h2>
            <p class="cl-text-muted cl-font-13 mb-3">@h.TeamsCount teams competing</p>
          </div>
          <div>
            <a class="cl-btn cl-btn--primary cl-w-100" asp-action="HackathonTeams" asp-route-id="@h.Id">Evaluate teams</a>
          </div>
        </article>
      </div>
    }
  </div>
}
