@model IEnumerable<Clutch.Web.Models.JudgeTeamScoreCardViewModel>
@{
    ViewData["Title"] = $"Judge Squads — {ViewData["HackathonTitle"]}";
    var isLocked = (bool)(ViewData["IsLocked"] ?? false);
    var hackathonId = (int)(ViewData["HackathonId"] ?? 0);
}

<div class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
    <div>
      <span class="cl-sticker @(isLocked ? "cl-sticker--closed" : "cl-sticker--judging") mb-2">
        @(isLocked ? "Judging locked" : "Scoring active")
      </span>
      <h1 class="display mb-1">@ViewData["HackathonTitle"]</h1>
      <p class="text-muted mb-0">Evaluate each squad's project submission against the rubric criteria.</p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
    {
      if (!isLocked)
      {
        <form asp-action="LockJudging" asp-route-id="@hackathonId" method="post" onsubmit="return confirm('Finalize and lock all scoring for this event? Scores will become immutable.');">
          @Html.AntiForgeryToken()
          <button class="cl-btn cl-btn--danger" type="submit">Lock judging & finalize</button>
        </form>
      }
      else
      {
        <a class="cl-btn cl-btn--primary" asp-controller="Leaderboard" asp-action="Index" asp-route-hackathonId="@hackathonId">View final results</a>
      }
    }
  </div>
</div>

<div class="cl-card">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead>
        <tr>
          <th>Squad</th>
          <th>Track</th>
          <th>Project</th>
          <th>Your evaluation</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var t in Model)
        {
          <tr>
            <td><strong>@t.TeamName</strong></td>
            <td>@(t.TrackName ?? "General")</td>
            <td>
              @if (t.HasSubmission)
              {
                <span class="fw-bold">@t.ProjectTitle</span>
              }
              else
              {
                <span class="text-muted small">No submission</span>
              }
            </td>
            <td>
              @if (t.HasJudgeScored)
              {
                <span class="cl-sticker cl-sticker--open py-0">Scored</span>
              }
              else
              {
                <span class="text-muted small">Pending score</span>
              }
            </td>
            <td>
              @if (t.CanJudge)
              {
                <a class="cl-btn cl-btn--secondary py-1 px-3" asp-action="ScoreTeam" asp-route-hackathonId="@hackathonId" asp-route-teamId="@t.TeamId">
                  @(t.HasJudgeScored ? "Edit score" : "Score squad")
                </a>
              }
              else
              {
                <span class="text-muted small">Unavailable</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
