@model IEnumerable<Clutch.Web.Models.JudgeTeamScoreCardViewModel>
@{
    ViewData["Title"] = $"Judge Teams — {ViewData["HackathonTitle"]}";
    var isLocked = (bool)(ViewData["IsLocked"] ?? false);
    var hackathonId = (int)(ViewData["HackathonId"] ?? 0);
}

<div class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
    <div>
      <partial name="_Badge" model='(isLocked ? "Judging locked" : "Scoring active", isLocked ? "closed" : "judging")' />
      <h1 class="cl-title-page mb-1 mt-2">@ViewData["HackathonTitle"]</h1>
      <p class="cl-text-muted cl-font-14 mb-0">Evaluate each team's project submission against the rubric criteria.</p>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
    {
      if (!isLocked)
      {
        <form asp-action="LockJudging" asp-route-id="@hackathonId" method="post" onsubmit="return confirm('Finalize and lock all scoring for this event? Scores will become immutable.');" class="m-0">
          @Html.AntiForgeryToken()
          <button class="cl-btn cl-btn--danger cl-btn--sm" type="submit">Lock judging & finalize</button>
        </form>
      }
      else
      {
        <a class="cl-btn cl-btn--primary cl-btn--sm" asp-controller="Leaderboard" asp-action="Index" asp-route-hackathonId="@hackathonId">View final results</a>
      }
    }
  </div>
</div>

<div class="cl-card p-0 overflow-hidden">
  <div class="table-responsive">
    <table class="cl-table">
      <thead>
        <tr>
          <th>Team</th>
          <th>Track</th>
          <th>Project</th>
          <th>Your evaluation</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var t in Model)
        {
          <tr>
            <td><strong>@t.TeamName</strong></td>
            <td><span class="cl-badge">@(t.TrackName ?? "General")</span></td>
            <td>
              @if (t.HasSubmission)
              {
                <span class="fw-semibold text-body">@t.ProjectTitle</span>
              }
              else
              {
                <span class="text-muted cl-font-13">No submission</span>
              }
            </td>
            <td>
              @if (t.HasJudgeScored)
              {
                <span class="cl-badge cl-badge--success">Scored</span>
              }
              else
              {
                <span class="cl-badge cl-badge--warning">Pending</span>
              }
            </td>
            <td class="text-end">
              @if (isLocked)
              {
                <span class="text-muted cl-font-13">Locked</span>
              }
              else
              {
                <a class="cl-btn cl-btn--secondary cl-btn--sm" asp-action="ScoreTeam" asp-route-hackathonId="@hackathonId" asp-route-teamId="@t.TeamId">
                  @(t.HasJudgeScored ? "Edit evaluation" : "Score team")
                </a>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
