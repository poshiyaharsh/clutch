@{ ViewData["Title"] = "Admin control panel"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="mb-1">Platform administration</h1>
    <p class="text-muted mb-0">Manage system roles, oversee all hackathons, and inspect audit activity.</p>
  </div>
  <div class="d-flex gap-2">
    <button class="cl-btn cl-btn--primary" type="button" onclick="clToast('System status: Healthy')">System health</button>
  </div>
</div>

<div class="cl-stats mb-5">
  <div class="cl-card cl-stat"><strong>3</strong>active hackathons</div>
  <div class="cl-card cl-stat"><strong>148</strong>registered users</div>
  <div class="cl-card cl-stat"><strong>73</strong>teams competing</div>
  <div class="cl-card cl-stat"><strong>12</strong>assigned judges</div>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-8">
    <div class="cl-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">User role directory</h2>
        <span class="cl-sticker">Role management</span>
      </div>
      <div style="overflow-x:auto">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Role</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Alex Rivera</strong></td>
              <td>alex.rivera@clutch.local</td>
              <td><span class="cl-sticker cl-sticker--open">Admin</span></td>
              <td><button class="cl-btn cl-btn--ghost py-1 px-2" type="button" onclick="clToast('Role permissions opened')">Edit</button></td>
            </tr>
            <tr>
              <td><strong>Sarah Chen</strong></td>
              <td>sarah.chen@univ.edu</td>
              <td><span class="cl-sticker">Organizer</span></td>
              <td><button class="cl-btn cl-btn--ghost py-1 px-2" type="button" onclick="clToast('Role permissions opened')">Edit</button></td>
            </tr>
            <tr>
              <td><strong>David Kim</strong></td>
              <td>dkim@ai-labs.io</td>
              <td><span class="cl-sticker cl-sticker--judging">Judge</span></td>
              <td><button class="cl-btn cl-btn--ghost py-1 px-2" type="button" onclick="clToast('Role permissions opened')">Edit</button></td>
            </tr>
            <tr>
              <td><strong>Maya Patel</strong></td>
              <td>maya.p@student.ac.in</td>
              <td><span class="cl-sticker cl-sticker--closed">Participant</span></td>
              <td><button class="cl-btn cl-btn--ghost py-1 px-2" type="button" onclick="clToast('Role permissions opened')">Edit</button></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="cl-card h-100">
      <h2 class="h4 mb-3">Recent audit trail</h2>
      <ul class="list-unstyled d-grid gap-3 mb-0">
        <li class="pb-2 border-bottom">
          <div class="small fw-bold">Hackathon published</div>
          <div class="text-muted small">CodeMind AI Hackathon by Sarah Chen</div>
          <div class="text-muted small">12 mins ago</div>
        </li>
        <li class="pb-2 border-bottom">
          <div class="small fw-bold">Judge assigned</div>
          <div class="text-muted small">David Kim assigned to Climate Jam</div>
          <div class="text-muted small">1 hour ago</div>
        </li>
        <li>
          <div class="small fw-bold">Judging locked</div>
          <div class="text-muted small">Spring Hack 2026 finalized by Admin</div>
          <div class="text-muted small">Yesterday</div>
        </li>
      </ul>
    </div>
  </div>
</div>
