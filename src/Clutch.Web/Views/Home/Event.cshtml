@model EventCard
@{
    ViewData["Title"] = Model.Title;
}

<!-- Event Banner / Header -->
<div class="mb-4">
  <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <partial name="_Badge" model="(Model.Status, Model.StatusClass)" />
    <span class="cl-text-muted cl-font-13">Organized by Clutch Official</span>
  </div>
  <h1 class="cl-title-page mb-2">@Model.Title</h1>
  <p class="cl-text-muted fs-5 cl-max-70ch mb-4">@Model.Blurb</p>

  <!-- Key Facts Strip -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="cl-card p-3">
        <div class="d-flex align-items-center gap-2 cl-text-muted cl-font-12 mb-1">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-calendar"></use></svg>
          <span>Duration</span>
        </div>
        <div class="fw-semibold text-body">@Model.DatesText</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cl-card p-3">
        <div class="d-flex align-items-center gap-2 cl-text-muted cl-font-12 mb-1">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-users"></use></svg>
          <span>Team Size</span>
        </div>
        <div class="fw-semibold text-body">1–4 members</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cl-card p-3">
        <div class="d-flex align-items-center gap-2 cl-text-muted cl-font-12 mb-1">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-trophy"></use></svg>
          <span>Prize Pool</span>
        </div>
        <div class="fw-semibold text-body">$10,000 USD</div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="cl-card p-3">
        <div class="d-flex align-items-center gap-2 cl-text-muted cl-font-12 mb-1">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-map-pin"></use></svg>
          <span>Location</span>
        </div>
        <div class="fw-semibold text-body">Virtual & Remote</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Left Side: Tabs Content -->
  <div class="col-12 col-lg-8">
    <ul class="nav nav-tabs border-bottom mb-4 cl-tabs-bar" id="eventTab" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="cl-tab-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" aria-selected="true">
          Overview
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="cl-tab-link" id="tracks-tab" data-bs-toggle="tab" data-bs-target="#tracks" type="button" role="tab" aria-selected="false">
          Tracks
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="cl-tab-link" id="rubric-tab" data-bs-toggle="tab" data-bs-target="#rubric" type="button" role="tab" aria-selected="false">
          Rubric
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="cl-tab-link" id="schedule-tab" data-bs-toggle="tab" data-bs-target="#schedule" type="button" role="tab" aria-selected="false">
          Schedule
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="cl-tab-link" id="announcements-tab" data-bs-toggle="tab" data-bs-target="#announcements" type="button" role="tab" aria-selected="false">
          Announcements
        </button>
      </li>
    </ul>

    <div class="tab-content" id="eventTabContent">
      <!-- Overview Tab -->
      <div class="tab-pane fade show active" id="overview" role="tabpanel" aria-labelledby="overview-tab">
        <div class="cl-card mb-4">
          <h2 class="cl-title-card mb-3">About the hackathon</h2>
          <p class="cl-text-muted">
            Welcome to the flagship event of the season. Engineers, designers, and innovators from across the globe gather to build impactful applications. Work individually or in teams of up to 4 to craft solutions that solve critical real-world challenges.
          </p>
          <p class="cl-text-muted mb-0">
            All teams must submit valid source code repository links and a working demo before the deadline. Submissions will be evaluated by industry judges using our transparent multi-criteria rubric.
          </p>
        </div>

        <div class="cl-card">
          <h3 class="cl-title-card mb-3">Rules and guidelines</h3>
          <ul class="d-flex flex-column gap-2 cl-text-muted cl-font-14 mb-0 ps-3">
            <li>Fresh code only: All project code must be authored during the hackathon period.</li>
            <li>Open source libraries and APIs are allowed and encouraged.</li>
            <li>Teams must adhere to the community code of conduct and treat peers with respect.</li>
            <li>Decisions of the judging committee on rubric scores are final.</li>
          </ul>
        </div>
      </div>

      <!-- Tracks Tab -->
      <div class="tab-pane fade" id="tracks" role="tabpanel" aria-labelledby="tracks-tab">
        <div class="d-flex flex-column gap-3">
          <div class="cl-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h3 class="cl-title-card mb-0">Healthcare & Biotech</h3>
              <span class="cl-badge cl-badge--accent">Track 1</span>
            </div>
            <p class="cl-text-muted cl-font-14 mb-0">
              Build intelligent diagnostic helpers, patient triage tools, and preventative wellness services using modern APIs.
            </p>
          </div>

          <div class="cl-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h3 class="cl-title-card mb-0">Education & Accessibility</h3>
              <span class="cl-badge cl-badge--accent">Track 2</span>
            </div>
            <p class="cl-text-muted cl-font-14 mb-0">
              Empower underserved students and learners worldwide with tailored tutoring, adaptive interfaces, and interactive learning tools.
            </p>
          </div>

          <div class="cl-card">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h3 class="cl-title-card mb-0">Open Innovation</h3>
              <span class="cl-badge cl-badge--accent">Track 3</span>
            </div>
            <p class="cl-text-muted cl-font-14 mb-0">
              Have an idea that does not fit conventional tracks? Explore bleeding-edge AI models, developer tooling, or decentralized protocols.
            </p>
          </div>
        </div>
      </div>

      <!-- Rubric Tab -->
      <div class="tab-pane fade" id="rubric" role="tabpanel" aria-labelledby="rubric-tab">
        <div class="d-flex flex-column gap-3">
          @foreach (var c in MockData.Rubric)
          {
            <div class="cl-card d-flex justify-content-between align-items-start gap-3">
              <div>
                <h3 class="cl-title-card mb-1">@c.Name</h3>
                <p class="cl-text-muted cl-font-14 mb-0">@c.Hint</p>
              </div>
              <span class="cl-badge cl-badge--accent cl-font-13">@c.Weight% weight</span>
            </div>
          }
        </div>
      </div>

      <!-- Schedule Tab -->
      <div class="tab-pane fade" id="schedule" role="tabpanel" aria-labelledby="schedule-tab">
        <div class="cl-card">
          <div class="d-flex flex-column gap-4">
            <div class="d-flex gap-3">
              <div class="fw-bold text-primary cl-font-13 min-w-90">Dec 5, 09:00</div>
              <div>
                <div class="fw-semibold text-body">Opening Ceremony & Hacking Begins</div>
                <div class="cl-text-muted cl-font-13">Live broadcast on YouTube and keynotes from sponsors.</div>
              </div>
            </div>
            <div class="d-flex gap-3">
              <div class="fw-bold text-primary cl-font-13 min-w-90">Dec 5, 14:00</div>
              <div>
                <div class="fw-semibold text-body">Mentor Office Hours</div>
                <div class="cl-text-muted cl-font-13">One-on-one architecture and product reviews with judges.</div>
              </div>
            </div>
            <div class="d-flex gap-3">
              <div class="fw-bold text-primary cl-font-13 min-w-90">Dec 6, 12:00</div>
              <div>
                <div class="fw-semibold text-body">Project Submission Deadline</div>
                <div class="cl-text-muted cl-font-13">Code repositories and demo videos locked for evaluation.</div>
              </div>
            </div>
            <div class="d-flex gap-3">
              <div class="fw-bold text-primary cl-font-13 min-w-90">Dec 6, 17:00</div>
              <div>
                <div class="fw-semibold text-body">Closing & Scoreboard Reveal</div>
                <div class="cl-text-muted cl-font-13">Live announcement of winners and prize distribution.</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Announcements Tab -->
      <div class="tab-pane fade" id="announcements" role="tabpanel" aria-labelledby="announcements-tab">
        <div class="cl-card">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="cl-badge cl-badge--accent">Official Broadcast</span>
            <span class="cl-text-muted cl-font-12">Posted 2 hours ago</span>
          </div>
          <h3 class="cl-title-card mb-2">API Credits Distributed</h3>
          <p class="cl-text-muted cl-font-14 mb-0">
            Sponsor API keys and $200 in cloud credits have been distributed to team leads via email. Check your spam inbox if you have not received them.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Right Side: Sticky Action Card with Countdown -->
  <aside class="col-12 col-lg-4">
    <div class="cl-card cl-sticky-sidebar">
      <div class="mb-4">
        <div class="d-flex align-items-center gap-2 cl-text-muted cl-font-13 mb-1">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-clock"></use></svg>
          <span>Registration closes in</span>
        </div>
        <div class="cl-title-section text-body tabular-nums">2 days 14 hours</div>
        <p class="cl-text-muted cl-font-13 mt-1 mb-0">Deadline: Dec 3, 23:59 UTC</p>
      </div>

      <div class="d-grid gap-2 mb-4">
        <a class="cl-btn cl-btn--primary cl-btn--lg w-100" asp-action="Team">
          <svg class="cl-icon"><use href="/img/icons.svg#icon-plus"></use></svg>
          <span>Create team</span>
        </a>

        <button class="cl-btn cl-btn--secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#join-box" aria-expanded="false" aria-controls="join-box">
          <svg class="cl-icon"><use href="/img/icons.svg#icon-users"></use></svg>
          <span>Join with code</span>
        </button>

        <div class="collapse" id="join-box">
          <div class="p-3 cl-card--soft rounded-2 mt-2 border">
            <div class="cl-field mb-2">
              <label class="cl-label" for="join-code">Team Join Code</label>
              <input id="join-code" class="cl-input text-uppercase" placeholder="e.g. K7Q2M9XD" maxlength="8" />
            </div>
            <button class="cl-btn cl-btn--primary cl-btn--sm cl-w-100" type="button" onclick="clToast('Joined team successfully')">
              Join team
            </button>
          </div>
        </div>
      </div>

      <div class="pt-3 border-top">
        <a class="d-flex justify-content-between align-items-center cl-text-muted cl-font-13" asp-action="Leaderboard" asp-route-id="@Model.Id">
          <span>View live event leaderboard</span>
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-right"></use></svg>
        </a>
      </div>
    </div>
  </aside>
</div>
