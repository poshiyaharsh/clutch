@model Clutch.Web.Models.HackathonDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
    <div class="d-flex align-items-center gap-2">
      <partial name="_Badge" model='(Model.Status.ToString(), Model.Status == Clutch.Web.Domain.HackathonStatus.Published ? "open" : "draft")' />
      <span class="text-muted" style="font-size: 13px;">Hosted by @Model.OrganizerName</span>
    </div>

    @if (User.IsInRole("Admin") || (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.OrganizerId))
    {
      <div class="dropdown">
        <button class="cl-btn cl-btn--secondary cl-btn--sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
          Manage status
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
          <li>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="m-0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="status" value="Published" />
              <button type="submit" class="dropdown-item py-2 px-3">Publish</button>
            </form>
          </li>
          <li>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="m-0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="status" value="Closed" />
              <button type="submit" class="dropdown-item py-2 px-3">Close submissions</button>
            </form>
          </li>
          <li>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="m-0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="status" value="Cancelled" />
              <button type="submit" class="dropdown-item py-2 px-3 text-danger">Cancel event</button>
            </form>
          </li>
        </ul>
      </div>
    }
  </div>

  <h1 class="cl-title-page mb-2">@Model.Title</h1>
  <p class="cl-text-muted fs-5 mb-0" style="max-width: 65ch;">@Model.Description</p>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="cl-card p-3">
      <div class="text-muted mb-1" style="font-size: 12px;">Duration</div>
      <div class="fw-semibold text-body">@Model.StartsAt.ToString("MMM d") – @Model.EndsAt.ToString("MMM d")</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="cl-card p-3">
      <div class="text-muted mb-1" style="font-size: 12px;">Teams</div>
      <div class="fw-semibold text-body">@Model.Teams.Count registered</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="cl-card p-3">
      <div class="text-muted mb-1" style="font-size: 12px;">Team Limit</div>
      <div class="fw-semibold text-body">Up to @Model.MaxTeamSize members</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="cl-card p-3">
      <div class="text-muted mb-1" style="font-size: 12px;">Registration</div>
      <div class="fw-semibold text-body">@(Model.IsRegistrationOpen ? "Open" : "Closed")</div>
    </div>
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-8">
    <div class="cl-card mb-4">
      <h2 class="cl-title-card mb-3">Competition tracks</h2>
      @if (!Model.Tracks.Any())
      {
        <p class="cl-text-muted mb-0">General open track.</p>
      }
      else
      {
        <div class="d-flex flex-wrap gap-2">
          @foreach (var track in Model.Tracks)
          {
            <span class="cl-badge cl-badge--accent" style="font-size: 13px; padding: 4px 12px;">@track.Name</span>
          }
        </div>
      }
    </div>

    <!-- Announcements -->
    <div class="cl-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="cl-title-card mb-0">Announcements</h2>
        @if (User.IsInRole("Admin") || (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.OrganizerId))
        {
          <button class="cl-btn cl-btn--secondary cl-btn--sm" type="button" data-bs-toggle="collapse" data-bs-target="#newAnnouncementForm">
            <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-plus"></use></svg>
            <span>Post announcement</span>
          </button>
        }
      </div>

      <div class="collapse mb-3" id="newAnnouncementForm">
        <form asp-action="PostAnnouncement" asp-route-id="@Model.Id" method="post" class="p-3 rounded-2 border" style="background: var(--surface-2);">
          @Html.AntiForgeryToken()
          <div class="cl-field mb-2">
            <label class="cl-label">Announcement Title</label>
            <input class="cl-input" name="title" required placeholder="Important update..." />
          </div>
          <div class="cl-field mb-3">
            <label class="cl-label">Message Body</label>
            <textarea class="cl-textarea" name="body" required rows="3"></textarea>
          </div>
          <button class="cl-btn cl-btn--primary cl-btn--sm" type="submit">Broadcast announcement</button>
        </form>
      </div>

      @if (!Model.Announcements.Any())
      {
        <p class="cl-text-muted mb-0" style="font-size: 14px;">No announcements posted yet.</p>
      }
      else
      {
        <div class="d-flex flex-column gap-3">
          @foreach (var a in Model.Announcements)
          {
            <div class="p-3 rounded-2" style="background: var(--surface-2);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-body" style="font-size: 14px;">@a.Title</strong>
                <span class="text-muted" style="font-size: 11px;">@a.CreatedAt.ToString("MMM d, HH:mm") UTC</span>
              </div>
              <p class="cl-text-muted mb-0" style="font-size: 13px; line-height: 1.5;">@a.Body</p>
            </div>
          }
        </div>
      }
    </div>

    <!-- Registered Squads -->
    <div class="cl-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="cl-title-card mb-0">Registered squads (@Model.Teams.Count)</h2>
      </div>

      @if (!Model.Teams.Any())
      {
        <p class="cl-text-muted mb-0" style="font-size: 14px;">No squads registered yet.</p>
      }
      else
      {
        <div class="table-responsive">
          <table class="cl-table">
            <thead>
              <tr>
                <th>Squad</th>
                <th>Lead</th>
                <th>Members</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var t in Model.Teams)
              {
                <tr>
                  <td><strong>@t.Name</strong></td>
                  <td>@t.LeadName</td>
                  <td class="tabular-nums">@t.MemberCount / @Model.MaxTeamSize</td>
                  <td>
                    @if (t.HasSubmitted)
                    {
                      <span class="cl-badge cl-badge--success">Submitted</span>
                    }
                    else
                    {
                      <span class="text-muted" style="font-size: 13px;">Pending</span>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="cl-card position-sticky" style="top: 88px;">
      <h2 class="cl-title-card mb-3">Compete in this event</h2>

      @if (Model.IsRegistrationOpen)
      {
        <p class="cl-text-muted mb-3" style="font-size: 13px;">Registration is open. Form a squad or join an existing team with an invite code.</p>

        @if (User.Identity?.IsAuthenticated == true)
        {
          <a class="cl-btn cl-btn--primary w-100 mb-2" asp-controller="Teams" asp-action="Create" asp-route-hackathonId="@Model.Id">Create a team</a>
          <a class="cl-btn cl-btn--secondary w-100 mb-3" asp-controller="Teams" asp-action="Join" asp-route-hackathonId="@Model.Id">Join with code</a>
        }
        else
        {
          <a class="cl-btn cl-btn--primary w-100 mb-2" asp-controller="Account" asp-action="Login">Sign in to join</a>
        }
      }
      else
      {
        <div class="p-3 rounded-2 mb-3" style="background: var(--warning-soft); color: var(--warning-fg); font-size: 13px;">
          Registration is closed for this event.
        </div>
      }

      <div class="pt-3 border-top d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-body" style="font-size: 13px;">Live Scoreboard</span>
        <a class="cl-btn cl-btn--ghost cl-btn--sm" asp-controller="Leaderboard" asp-action="Index" asp-route-hackathonId="@Model.Id">
          <span>View ranks</span>
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-right"></use></svg>
        </a>
      </div>
    </div>
  </div>
</div>
