@model Clutch.Web.Models.HackathonDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-2">
    <div class="d-flex align-items-center gap-2">
      <span class="cl-sticker @(Model.Status == Clutch.Web.Domain.HackathonStatus.Published ? "cl-sticker--open" : "cl-sticker--draft")">
        @Model.Status
      </span>
      <span class="text-muted small">Hosted by @Model.OrganizerName</span>
    </div>

    @if (User.IsInRole("Admin") || (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.OrganizerId))
    {
      <div class="dropdown">
        <button class="cl-btn cl-btn--secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
          Manage status
        </button>
        <ul class="dropdown-menu">
          <li>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="status" value="Published" />
              <button type="submit" class="dropdown-item">Publish</button>
            </form>
          </li>
          <li>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="status" value="Closed" />
              <button type="submit" class="dropdown-item">Close submissions</button>
            </form>
          </li>
          <li>
            <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
              @Html.AntiForgeryToken()
              <input type="hidden" name="status" value="Cancelled" />
              <button type="submit" class="dropdown-item text-danger">Cancel event</button>
            </form>
          </li>
        </ul>
      </div>
    }
  </div>

  <h1 class="display mb-3">@Model.Title</h1>
  <p class="lead" style="max-width: 65ch;">@Model.Description</p>
</div>

<div class="cl-stats mb-5">
  <div class="cl-card cl-stat">
    <strong>@Model.StartsAt.ToString("MMM d") – @Model.EndsAt.ToString("MMM d")</strong>
    Event duration
  </div>
  <div class="cl-card cl-stat">
    <strong>@Model.Teams.Count</strong>
    Teams registered
  </div>
  <div class="cl-card cl-stat">
    <strong>Max @Model.MaxTeamSize</strong>
    Hackers per squad
  </div>
  <div class="cl-card cl-stat">
    <strong>@(Model.IsRegistrationOpen ? "Open" : "Closed")</strong>
    Registration
  </div>
</div>

<div class="row g-4 mb-5">
  <div class="col-12 col-lg-8">
    @if (Model.Tracks.Any())
    {
      <div class="cl-card mb-4">
        <h2 class="h4 mb-3">Tracks & Themes</h2>
        <div class="d-flex flex-wrap gap-2">
          @foreach (var tr in Model.Tracks)
          {
            <div class="p-2 px-3 border rounded-pill bg-light fw-bold small">
              @tr.Name
            </div>
          }
        </div>
      </div>
    }

    <div class="cl-card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h4 mb-0">Announcements</h2>
        @if (User.IsInRole("Admin") || (User.Identity?.IsAuthenticated == true && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.OrganizerId))
        {
          <button class="cl-btn cl-btn--ghost py-1 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#postAnnouncement">
            + Post announcement
          </button>
        }
      </div>

      <div class="collapse mb-3" id="postAnnouncement">
        <form asp-action="AddAnnouncement" asp-route-id="@Model.Id" method="post" class="p-3 border rounded">
          @Html.AntiForgeryToken()
          <div class="cl-field">
            <label class="cl-label">Title</label>
            <input class="cl-input" name="title" required placeholder="Announcement headline" />
          </div>
          <div class="cl-field">
            <label class="cl-label">Content</label>
            <textarea class="cl-textarea" name="body" rows="3" required placeholder="Announcement message..."></textarea>
          </div>
          <button class="cl-btn cl-btn--primary" type="submit">Publish announcement</button>
        </form>
      </div>

      @if (!Model.Announcements.Any())
      {
        <p class="text-muted small mb-0">No announcements posted yet.</p>
      }
      else
      {
        <div class="d-grid gap-3">
          @foreach (var a in Model.Announcements)
          {
            <div class="p-3 border rounded">
              <div class="d-flex justify-content-between small text-muted mb-1">
                <span class="fw-bold">@a.AuthorName</span>
                <span>@a.CreatedAt.ToString("g")</span>
              </div>
              <h3 class="h5 mb-1">@a.Title</h3>
              <p class="mb-0 text-muted">@a.Body</p>
            </div>
          }
        </div>
      }
    </div>

    <div class="cl-card">
      <h2 class="h4 mb-3">Registered squads (@Model.Teams.Count)</h2>
      @if (!Model.Teams.Any())
      {
        <p class="text-muted small mb-0">Be the first team to enter this hackathon!</p>
      }
      else
      {
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Squad</th>
                <th>Leader</th>
                <th>Members</th>
                <th>Submission</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var t in Model.Teams)
              {
                <tr>
                  <td><strong>@t.Name</strong></td>
                  <td>@t.LeadName</td>
                  <td>@t.MemberCount / @Model.MaxTeamSize</td>
                  <td>
                    @if (t.HasSubmitted)
                    {
                      <span class="cl-sticker cl-sticker--open py-0">Submitted</span>
                    }
                    else
                    {
                      <span class="text-muted small">Pending</span>
                    }
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      }
    </div>
  </div>

  <div class="col-12 col-lg-4">
    <div class="cl-card cl-sticky">
      <h2 class="h4 mb-3">Compete in this event</h2>

      @if (Model.IsRegistrationOpen)
      {
        <p class="small text-muted mb-3">Registration is currently open. Form a squad or join an existing team with an invite code.</p>

        @if (User.Identity?.IsAuthenticated == true)
        {
          <a class="cl-btn cl-btn--primary w-100 mb-2" asp-controller="Teams" asp-action="Create" asp-route-hackathonId="@Model.Id">Create a team</a>
          <a class="cl-btn cl-btn--secondary w-100 mb-3" asp-controller="Teams" asp-action="Join" asp-route-hackathonId="@Model.Id">Join with code</a>
        }
        else
        {
          <a class="cl-btn cl-btn--primary w-100 mb-2" asp-controller="Account" asp-action="Login">Sign in to join</a>
        }
      }
      else
      {
        <div class="alert alert-warning mb-3">
          Registration is closed for this event.
        </div>
      }

      <hr />
      <div class="d-flex justify-content-between align-items-center">
        <span class="small fw-bold">Leaderboard</span>
        <a class="cl-btn cl-btn--ghost py-1 px-3" asp-controller="Home" asp-action="Leaderboard" asp-route-id="@Model.Id">View ranks</a>
      </div>
    </div>
  </div>
</div>
