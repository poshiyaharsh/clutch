@model IEnumerable<Clutch.Web.Models.HackathonListItemViewModel>
@{
    ViewData["Title"] = "Browse Hackathons";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="cl-title-page mb-1">Active Hackathons</h1>
    <p class="cl-text-muted cl-font-14 mb-0">Browse published hackathons, form teams, and show up to compete.</p>
  </div>
  @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
  {
    <a class="cl-btn cl-btn--primary" asp-action="Create">
      <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-plus"></use></svg>
      <span>Host a hackathon</span>
    </a>
  }
</div>

@if (!Model.Any())
{
  <partial name="_EmptyState" model='("No active hackathons found", "Check back soon or create your own hackathon if you have organizer privileges.", "Host a hackathon", "/hackathons/create")' />
}
else
{
  <div class="row g-4">
    @foreach (var h in Model)
    {
      <div class="col-12 col-md-6 col-lg-4">
        <article class="cl-card h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <partial name="_Badge" model='(h.Status.ToString(), h.Status == Clutch.Web.Domain.HackathonStatus.Published ? "open" : "draft")' />
              <span class="text-muted cl-font-12">@h.StartsAt.ToString("MMM d") – @h.EndsAt.ToString("MMM d")</span>
            </div>
            <h2 class="cl-title-card mb-2">@h.Title</h2>
            <p class="cl-text-muted cl-font-13 cl-line-height-15 mb-3">@h.Description</p>
          </div>
          <div>
            <div class="d-flex justify-content-between align-items-center mb-3 text-muted cl-font-12">
              <span><strong>@h.TeamCount</strong> teams registered</span>
              <span>Team max: @h.MaxTeamSize</span>
            </div>
            <a class="cl-btn cl-btn--secondary cl-w-100" asp-action="Detail" asp-route-slug="@h.Slug">
              <span>View event</span>
              <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-chevron-right"></use></svg>
            </a>
          </div>
        </article>
      </div>
    }
  </div>
}
