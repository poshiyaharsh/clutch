@model Clutch.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="cl-empty my-5">
  <span class="cl-sticker cl-sticker--draft mb-3">Error</span>
  <h1 class="h2 mb-2">Something went wrong</h1>
  <p class="text-muted mb-4">An unexpected issue occurred while processing your request. Our team has been notified.</p>

  @if (Model?.ShowRequestId == true)
  {
    <p class="small text-muted mb-4">Request ID: <code>@Model.RequestId</code></p>
  }

  <div class="d-flex justify-content-center gap-3">
    <a class="cl-btn cl-btn--primary" asp-controller="Home" asp-action="Index">Return home</a>
  </div>
</div>
