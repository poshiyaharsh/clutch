<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] ?? "Clutch")</title>
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <a class="cl-skip" href="#main">Skip to content</a>
  <header class="cl-header">
    <div class="container d-flex align-items-center justify-content-between py-3">
      <a class="cl-logo display d-inline-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" aria-label="Clutch home"><img src="~/favicon.svg" alt="" width="36" height="36" />Clutch</a>
      <nav class="d-flex align-items-center gap-2 gap-md-3" aria-label="Main">
        <a class="cl-navlink d-none d-sm-inline" asp-controller="Home" asp-action="Index">Events</a>
        <a class="cl-navlink d-none d-sm-inline" asp-controller="Home" asp-action="Organizer">Host</a>
        <a class="cl-navlink d-none d-md-inline" asp-controller="Home" asp-action="Admin">Admin</a>
        <partial name="_NotificationBell" />
        <a class="cl-btn cl-btn--secondary" href="#">Sign in</a>
      </nav>
    </div>
  </header>

  <main id="main" class="container py-4 py-md-5">
    @RenderBody()
  </main>

  <footer class="container py-4 cl-footer">
    <p class="mb-0">Clutch. Show up. Clutch it.</p>
  </footer>

  <partial name="_Toast" />
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
