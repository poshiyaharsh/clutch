<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] is null ? "Clutch" : $"{ViewData["Title"]} · Clutch")</title>
  
  <!-- Anti-FOUC Theme Script (single source of truth: syncs data-theme and data-bs-theme) -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('clutch-theme-preference');
        var theme = (saved === 'dark' || saved === 'light') ? saved : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-bs-theme', theme);
      } catch (e) {}
    })();
  </script>

  <!-- Brand Favicons & Icons -->
  <link rel="icon" type="image/svg+xml" href="~/img/brand/clutch-mark.svg" />
  <link rel="alternate icon" type="image/png" href="~/img/brand/favicon-32.png" />
  <link rel="apple-touch-icon" href="~/img/brand/apple-touch-icon.png" />
  <link rel="manifest" href="~/img/brand/site.webmanifest" />

  <!-- Theme Color Meta Tags -->
  <meta name="theme-color" content="#FAFAFB" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0B0B0F" media="(prefers-color-scheme: dark)" />

  <!-- Open Graph & Social Cards -->
  <meta property="og:title" content="@(ViewData["Title"] ?? "Clutch") · Clutch" />
  <meta property="og:description" content="Clutch — Real-time hackathon management, rubric judging, and live evaluated scoreboard platform." />
  <meta property="og:image" content="/img/brand/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/clutch-theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <a class="cl-skip" href="#main-content">Skip to content</a>

  <!-- Top Slim Header -->
  <header class="cl-navbar">
    <div class="cl-navbar-container">
      <div class="d-flex align-items-center gap-4">
        <a class="cl-brand" asp-controller="Home" asp-action="Index" aria-label="Clutch home">
          <partial name="_Logo" model='("md", "full")' />
        </a>

        <nav class="d-none d-md-flex" aria-label="Main navigation">
          <ul class="cl-nav-links">
            <li><a class="cl-nav-link" asp-controller="Home" asp-action="Index">Discover</a></li>
            <li><a class="cl-nav-link" asp-controller="Home" asp-action="Leaderboard" asp-route-id="1">Leaderboard</a></li>
            @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
            {
              <li><a class="cl-nav-link" asp-controller="Home" asp-action="Organizer">Organizer</a></li>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Judge"))
            {
              <li><a class="cl-nav-link" asp-controller="Home" asp-action="Judge">Scoring</a></li>
            }
            @if (User.IsInRole("Admin"))
            {
              <li><a class="cl-nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
            }
          </ul>
        </nav>
      </div>

      <div class="cl-nav-actions">
        <!-- Quick Search Ctrl+K -->
        <button type="button" class="cl-search-trigger d-none d-sm-inline-flex" data-command-trigger aria-label="Quick search (Ctrl+K)">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-search"></use></svg>
          <span>Search...</span>
          <span class="cl-kbd">Ctrl K</span>
        </button>

        <!-- Theme Switcher -->
        <partial name="_ThemeToggle" />

        <!-- Notification Bell -->
        <partial name="_NotificationBell" />

        <!-- User Menu / Auth -->
        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="dropdown">
            <button class="cl-btn cl-btn--secondary cl-btn--sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              @(User.Identity.Name?.Split('@')[0])
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm p-1">
              <li><a class="dropdown-item py-2 px-3 rounded-2" asp-controller="Home" asp-action="Team">My team</a></li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="dropdown-item py-2 px-3 rounded-2 text-danger">Sign out</button>
                </form>
              </li>
            </ul>
          </div>
        }
        else
        {
          <a class="cl-btn cl-btn--primary cl-btn--sm" asp-controller="Account" asp-action="Login">Sign in</a>
        }
      </div>
    </div>
  </header>

  <!-- Main Content Shell -->
  <main id="main-content" class="cl-main">
    @RenderBody()
  </main>

  <!-- Generous Product Footer -->
  <footer class="cl-footer">
    <div class="cl-footer-container">
      <div class="d-flex align-items-center gap-3">
        <partial name="_Logo" model='("sm", "full")' />
        <span class="cl-text-muted cl-font-13">High-performance hackathon management portal</span>
      </div>
      <ul class="cl-footer-links">
        <li><a asp-controller="Home" asp-action="Index">Explore</a></li>
        <li><a asp-controller="Home" asp-action="Leaderboard" asp-route-id="1">Leaderboard</a></li>
        <li><a asp-controller="Home" asp-action="Organizer">Host Event</a></li>
        <li><span class="cl-text-muted">v2.0</span></li>
      </ul>
    </div>
  </footer>

  <partial name="_CommandMenu" />
  <partial name="_Toast" />

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
