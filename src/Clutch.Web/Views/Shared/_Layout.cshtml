<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] ?? "Clutch") — Hackathon Platform</title>
  
  <!-- Anti-FOUC Theme Script -->
  <script>
    (function () {
      try {
        var saved = localStorage.getItem('clutch-theme-preference');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
      } catch (e) {}
    })();
  </script>

  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="~/css/clutch-theme.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <a class="cl-skip" href="#main-content">Skip to content</a>

  <!-- Top Slim Header -->
  <header class="cl-navbar">
    <div class="cl-navbar-container">
      <div class="d-flex align-items-center gap-4">
        <a class="cl-brand" asp-controller="Home" asp-action="Index" aria-label="Clutch home">
          <span class="cl-brand-logo bg-primary text-white">
            <svg class="cl-icon" style="width: 18px; height: 18px; stroke: #fff;"><use href="/img/icons.svg#icon-sparkles"></use></svg>
          </span>
          <span>Clutch</span>
        </a>

        <nav class="d-none d-md-flex" aria-label="Main navigation">
          <ul class="cl-nav-links">
            <li><a class="cl-nav-link" asp-controller="Home" asp-action="Index">Discover</a></li>
            <li><a class="cl-nav-link" asp-controller="Home" asp-action="Leaderboard" asp-route-id="1">Leaderboard</a></li>
            @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
            {
              <li><a class="cl-nav-link" asp-controller="Home" asp-action="Organizer">Organizer</a></li>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Judge"))
            {
              <li><a class="cl-nav-link" asp-controller="Home" asp-action="Judge">Scoring</a></li>
            }
            @if (User.IsInRole("Admin"))
            {
              <li><a class="cl-nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
            }
          </ul>
        </nav>
      </div>

      <div class="cl-nav-actions">
        <!-- Quick Search Ctrl+K -->
        <button type="button" class="cl-search-trigger d-none d-sm-inline-flex" data-command-trigger aria-label="Quick search (Ctrl+K)">
          <svg class="cl-icon cl-icon-sm"><use href="/img/icons.svg#icon-search"></use></svg>
          <span>Search...</span>
          <span class="cl-kbd">Ctrl K</span>
        </button>

        <!-- Theme Switcher -->
        <partial name="_ThemeToggle" />

        <!-- Notification Bell -->
        <partial name="_NotificationBell" />

        <!-- User Menu / Auth -->
        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="dropdown">
            <button class="cl-btn cl-btn--secondary cl-btn--sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              @(User.Identity.Name?.Split('@')[0])
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm p-1" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);">
              <li><a class="dropdown-item py-2 px-3 rounded-2" asp-controller="Home" asp-action="Team">My squad</a></li>
              <li><hr class="dropdown-divider my-1" style="border-color: var(--border);"></li>
              <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                  @Html.AntiForgeryToken()
                  <button type="submit" class="dropdown-item py-2 px-3 rounded-2 text-danger">Sign out</button>
                </form>
              </li>
            </ul>
          </div>
        }
        else
        {
          <a class="cl-btn cl-btn--primary cl-btn--sm" asp-controller="Account" asp-action="Login">Sign in</a>
        }
      </div>
    </div>
  </header>

  <!-- Main Content Shell -->
  <main id="main-content" class="cl-main">
    @RenderBody()
  </main>

  <!-- Generous Product Footer -->
  <footer class="cl-footer">
    <div class="cl-footer-container">
      <div class="d-flex align-items-center gap-3">
        <span class="cl-brand-logo bg-primary text-white" style="width: 24px; height: 24px;">
          <svg class="cl-icon" style="width: 14px; height: 14px; stroke: #fff;"><use href="/img/icons.svg#icon-sparkles"></use></svg>
        </span>
        <span class="fw-semibold text-body">Clutch</span>
        <span class="text-muted">High-performance hackathon management portal</span>
      </div>
      <ul class="cl-footer-links">
        <li><a asp-controller="Home" asp-action="Index">Explore</a></li>
        <li><a asp-controller="Home" asp-action="Leaderboard" asp-route-id="1">Leaderboard</a></li>
        <li><a asp-controller="Home" asp-action="Organizer">Host Event</a></li>
        <li><span class="text-muted">v2.0</span></li>
      </ul>
    </div>
  </footer>

  <partial name="_CommandMenu" />
  <partial name="_Toast" />

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
