<div class="dropdown">
  <button type="button" class="cl-btn cl-btn--ghost cl-btn--icon-only position-relative" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Notifications (2 unread)">
    <svg class="cl-icon"><use href="/img/icons.svg#icon-bell"></use></svg>
    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill cl-badge--accent cl-font-11 py-1 px-2">
      2
    </span>
  </button>
  <div class="dropdown-menu dropdown-menu-end shadow-md p-0 cl-dropdown-menu-wide">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
      <span class="fw-semibold text-body cl-font-14">Notifications</span>
      <span class="cl-badge cl-badge--accent">2 new</span>
    </div>
    <div class="d-flex flex-column p-2 gap-1 cl-notif-scroll">
      <div class="p-2 rounded-2 cl-card--interactive">
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="cl-badge cl-badge--warning">Judging</span>
          <span class="cl-text-muted cl-font-11">10m ago</span>
        </div>
        <p class="mb-0 fw-medium cl-font-13">Campus Climate Jam is now open for evaluation.</p>
      </div>
      <div class="p-2 rounded-2 cl-card--interactive">
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="cl-badge cl-badge--success">Team</span>
          <span class="cl-text-muted cl-font-11">1h ago</span>
        </div>
        <p class="mb-0 fw-medium cl-font-13">Byte Me accepted your member request.</p>
      </div>
    </div>
  </div>
</div>
