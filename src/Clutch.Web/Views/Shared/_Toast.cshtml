@{
  var toastText = TempData["Toast"] ?? TempData["ToastMessage"] ?? TempData["ToastError"];
}
<div id="cl-toast" class="cl-toast" role="status" aria-live="polite" hidden>@toastText</div>
@if (toastText is not null)
{
  <script>document.addEventListener('DOMContentLoaded', () => window.clToast(document.getElementById('cl-toast').textContent));</script>
}
